name: sre-bot-cicd
on:
    push:
        branches: [master]
    pull_request:
        branches: [master]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-go@v4
        with:
          go-version: '1.26'
      - run: go build ./...
        working-directory: collector
      - uses: docker/login-action@v2
        with:
            username: ${{ secrets.DOCKER_USERNAME }}
            password: ${{ secrets.DOCKER_PASSWORD }}
      - run: docker build -t ${{ secrets.DOCKER_USERNAME }}/sre-bot-collector:latest -f collector/Dockerfile .
      - run: docker push ${{ secrets.DOCKER_USERNAME }}/sre-bot-collector:latest
      - run: docker build -t ${{ secrets.DOCKER_USERNAME }}/sre-bot-aggregator:latest -f aggregator/Dockerfile .
      - run: docker push ${{ secrets.DOCKER_USERNAME }}/sre-bot-aggregator:latest
      - run: docker build -t ${{ secrets.DOCKER_USERNAME }}/sre-bot-agent:latest -f agent/Dockerfile .
      - run: docker push ${{ secrets.DOCKER_USERNAME }}/sre-bot-agent:latest
      - run: docker build -t ${{ secrets.DOCKER_USERNAME }}/sre-bot-detector:latest -f detector/Dockerfile .
      - run: docker push ${{ secrets.DOCKER_USERNAME }}/sre-bot-detector:latest
